# Module: aosp_training_random
#
# This is a "driver" like module.
# I.e. it uses `*init()` and `*exit()` functions to setup things (sysfs
# entries, in this case) to be invoked from outside the kernel code -- in this
# case by a user space process reading from the sysfs entries.
#
# At the beginning when you start the exercise, this module is "stand alone"
# and only provides a single sysfs entry.
# You will have to extend both, the code and the module definition below to
# make it interact with the random number generator created above.
# For instance, we need to tell kleaf that we want the modules to depend on
# each other.
ddk_module(
    name = "training_mod",
    srcs = ["training_mod.c"],
    out = "aosp_training_sysfs.ko",
    kernel_build = "//common:kernel_x86_64",
    deps = [
        "//common:all_headers_x86_64",
    ],
)
